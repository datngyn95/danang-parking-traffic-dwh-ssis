    <DTS:Executable
      DTS:refId="Package\SQL - Complete Batch"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{DCCDBA9A-B87A-4B74-8193-7168124AFD1C}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL - Complete Batch"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{359A8995-C9EE-4D08-8748-273225D70AB2}"
          SQLTask:SqlStatementSource="UPDATE etl.LoadBatch&#xA;SET&#xA;    CompletedAt = SYSDATETIME()&#xA;WHERE LoadBatchKey = CONVERT(bigint, ?)&#xA;  AND LoadStatus = 'SILVER_VALIDATED'&#xA;  AND ErrorMessage IS NULL&#xA;  AND CompletedAt IS NULL;&#xA;&#xA;IF @@ROWCOUNT &lt;&gt; 1&#xA;BEGIN&#xA;    THROW 54100,&#xA;        'COMPLETE BATCH FAILED - expected exactly one active batch',&#xA;        1;&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::LoadBatchKey"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL - Reconcile Fact Load"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{9A02AC55-5B0D-40CF-B6C5-135DF74DBF6C}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL - Reconcile Fact Load"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{359A8995-C9EE-4D08-8748-273225D70AB2}"
          SQLTask:SqlStatementSource="DECLARE @LoadBatchKey bigint = CONVERT(bigint, ?);&#xA;&#xA;DECLARE&#xA;    @SrcParkingCapacity bigint,&#xA;    @SrcRoadSurvey      bigint,&#xA;    @SrcWeather         bigint,&#xA;    @SrcTraffic         bigint,&#xA;    @SrcParkingEvent    bigint,&#xA;&#xA;    @TgtParkingCapacity bigint,&#xA;    @TgtRoadSurvey      bigint,&#xA;    @TgtWeather         bigint,&#xA;    @TgtTraffic         bigint,&#xA;    @TgtParkingEvent    bigint;&#xA;&#xA;&#xA;/* =========================================================&#xA;   0. BATCH PHẢI ĐANG CHỜ HOÀN TẤT&#xA;   ========================================================= */&#xA;&#xA;IF NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM etl.LoadBatch&#xA;    WHERE LoadBatchKey = @LoadBatchKey&#xA;      AND LoadStatus = 'SILVER_VALIDATED'&#xA;      AND ErrorMessage IS NULL&#xA;      AND CompletedAt IS NULL&#xA;)&#xA;BEGIN&#xA;    THROW 54000,&#xA;        'RECONCILIATION FAILED - batch is not active SILVER_VALIDATED',&#xA;        1;&#xA;END;&#xA;&#xA;&#xA;/* =========================================================&#xA;   1. SOURCE EXPECTED COUNTS&#xA;   ========================================================= */&#xA;&#xA;SELECT @SrcParkingCapacity = COUNT_BIG(*)&#xA;FROM DanangSmartParkingSTG.transform.ParkingFacilityClean&#xA;WHERE LoadBatchKey = @LoadBatchKey&#xA;  AND IsValid = 1;&#xA;&#xA;&#xA;SELECT @SrcRoadSurvey = COUNT_BIG(*)&#xA;FROM DanangSmartParkingSTG.transform.RoadSurveyClean&#xA;WHERE LoadBatchKey = @LoadBatchKey&#xA;  AND IsValid = 1;&#xA;&#xA;&#xA;SELECT @SrcWeather = COUNT_BIG(*)&#xA;FROM DanangSmartParkingSTG.transform.WeatherHourlyClean&#xA;WHERE LoadBatchKey = @LoadBatchKey&#xA;  AND IsValid = 1;&#xA;&#xA;&#xA;SELECT @SrcTraffic = COUNT_BIG(*)&#xA;FROM DanangSmartParkingSTG.transform.TrafficObservationClean&#xA;WHERE LoadBatchKey = @LoadBatchKey&#xA;  AND IsValid = 1&#xA;  AND DuplicateRank = 1;&#xA;&#xA;&#xA;SELECT @SrcParkingEvent = COUNT_BIG(*)&#xA;FROM DanangSmartParkingSTG.transform.ParkingEventClean&#xA;WHERE LoadBatchKey = @LoadBatchKey&#xA;  AND IsValid = 1&#xA;  AND DuplicateRank = 1;&#xA;&#xA;&#xA;/* =========================================================&#xA;   2. BASELINE DATASET COUNTS&#xA;   ========================================================= */&#xA;&#xA;IF @SrcParkingCapacity &lt;&gt; 20&#xA;    THROW 54001,&#xA;        'RECONCILIATION FAILED - ParkingCapacity source != 20',&#xA;        1;&#xA;&#xA;IF @SrcRoadSurvey &lt;&gt; 30&#xA;    THROW 54002,&#xA;        'RECONCILIATION FAILED - RoadSurvey source != 30',&#xA;        1;&#xA;&#xA;IF @SrcWeather &lt;&gt; 168&#xA;    THROW 54003,&#xA;        'RECONCILIATION FAILED - Weather source != 168',&#xA;        1;&#xA;&#xA;IF @SrcTraffic &lt;&gt; 16800&#xA;    THROW 54004,&#xA;        'RECONCILIATION FAILED - Traffic source != 16800',&#xA;        1;&#xA;&#xA;IF @SrcParkingEvent &lt;&gt; 4283&#xA;    THROW 54005,&#xA;        'RECONCILIATION FAILED - ParkingEvent source != 4283',&#xA;        1;&#xA;&#xA;&#xA;/* =========================================================&#xA;   3. PARKING CAPACITY TARGET COVERAGE&#xA;   ========================================================= */&#xA;&#xA;SELECT @TgtParkingCapacity = COUNT_BIG(*)&#xA;FROM dwh.FactParkingCapacitySnapshot F&#xA;JOIN dwh.DimDate D&#xA;    ON D.DateKey = F.SnapshotDateKey&#xA;JOIN dwh.DimParkingFacility PF&#xA;    ON PF.ParkingFacilityKey = F.ParkingFacilityKey&#xA;WHERE D.DateValue = CONVERT(date, '2026-08-05')&#xA;  AND EXISTS&#xA;  (&#xA;      SELECT 1&#xA;      FROM DanangSmartParkingSTG.transform.ParkingFacilityClean S&#xA;      WHERE S.LoadBatchKey = @LoadBatchKey&#xA;        AND S.IsValid = 1&#xA;        AND S.ParkingID = PF.ParkingID&#xA;  );&#xA;&#xA;&#xA;/* =========================================================&#xA;   4. ROAD SURVEY TARGET COVERAGE&#xA;   ========================================================= */&#xA;&#xA;SELECT @TgtRoadSurvey = COUNT_BIG(*)&#xA;FROM dwh.FactRoadSurveySnapshot F&#xA;JOIN dwh.DimDate D&#xA;    ON D.DateKey = F.SnapshotDateKey&#xA;JOIN dwh.DimRoadSegment RS&#xA;    ON RS.SegmentKey = F.SegmentKey&#xA;WHERE D.DateValue = CONVERT(date, '2026-08-05')&#xA;  AND EXISTS&#xA;  (&#xA;      SELECT 1&#xA;      FROM DanangSmartParkingSTG.transform.RoadSurveyClean S&#xA;      WHERE S.LoadBatchKey = @LoadBatchKey&#xA;        AND S.IsValid = 1&#xA;        AND S.SegmentID = RS.SegmentID&#xA;  );&#xA;&#xA;&#xA;/* =========================================================&#xA;   5. WEATHER TARGET COVERAGE&#xA;   ========================================================= */&#xA;&#xA;SELECT @TgtWeather = COUNT_BIG(*)&#xA;FROM dwh.FactWeatherHourly F&#xA;WHERE EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM DanangSmartParkingSTG.transform.WeatherHourlyClean S&#xA;    WHERE S.LoadBatchKey = @LoadBatchKey&#xA;      AND S.IsValid = 1&#xA;      AND S.WeatherTimestamp = F.WeatherTimestamp&#xA;);&#xA;&#xA;&#xA;/* =========================================================&#xA;   6. TRAFFIC TARGET COVERAGE&#xA;   ========================================================= */&#xA;&#xA;SELECT @TgtTraffic = COUNT_BIG(*)&#xA;FROM dwh.FactTrafficObservation F&#xA;WHERE EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM DanangSmartParkingSTG.transform.TrafficObservationClean S&#xA;    WHERE S.LoadBatchKey = @LoadBatchKey&#xA;      AND S.IsValid = 1&#xA;      AND S.DuplicateRank = 1&#xA;      AND S.EventID = F.EventID&#xA;);&#xA;&#xA;&#xA;/* =========================================================&#xA;   7. PARKING EVENT TARGET COVERAGE&#xA;   ========================================================= */&#xA;&#xA;SELECT @TgtParkingEvent = COUNT_BIG(*)&#xA;FROM dwh.FactParkingEvent F&#xA;WHERE EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM DanangSmartParkingSTG.transform.ParkingEventClean S&#xA;    WHERE S.LoadBatchKey = @LoadBatchKey&#xA;      AND S.IsValid = 1&#xA;      AND S.DuplicateRank = 1&#xA;      AND S.EventID = F.EventID&#xA;);&#xA;&#xA;&#xA;/* =========================================================&#xA;   8. SOURCE VS TARGET&#xA;   ========================================================= */&#xA;&#xA;IF @TgtParkingCapacity &lt;&gt; @SrcParkingCapacity&#xA;    THROW 54010,&#xA;        'RECONCILIATION FAILED - ParkingCapacity source/target mismatch',&#xA;        1;&#xA;&#xA;IF @TgtRoadSurvey &lt;&gt; @SrcRoadSurvey&#xA;    THROW 54011,&#xA;        'RECONCILIATION FAILED - RoadSurvey source/target mismatch',&#xA;        1;&#xA;&#xA;IF @TgtWeather &lt;&gt; @SrcWeather&#xA;    THROW 54012,&#xA;        'RECONCILIATION FAILED - Weather source/target mismatch',&#xA;        1;&#xA;&#xA;IF @TgtTraffic &lt;&gt; @SrcTraffic&#xA;    THROW 54013,&#xA;        'RECONCILIATION FAILED - Traffic source/target mismatch',&#xA;        1;&#xA;&#xA;IF @TgtParkingEvent &lt;&gt; @SrcParkingEvent&#xA;    THROW 54014,&#xA;        'RECONCILIATION FAILED - ParkingEvent source/target mismatch',&#xA;        1;&#xA;&#xA;&#xA;/* =========================================================&#xA;   PASS&#xA;   ========================================================= */&#xA;&#xA;PRINT 'PACKAGE 40 RECONCILIATION = PASS';&#xA;PRINT 'ParkingCapacity = 20';&#xA;PRINT 'RoadSurvey      = 30';&#xA;PRINT 'Weather         = 168';&#xA;PRINT 'Traffic         = 16800';&#xA;PRINT 'ParkingEvent    = 4283';&#xA;PRINT 'Total Facts     = 21301';" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::LoadBatchKey"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL - Start Batch"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{4CBBDEC9-3A11-4EE3-BA51-22A0795238F2}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL - Start Batch"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{359A8995-C9EE-4D08-8748-273225D70AB2}"
          SQLTask:SqlStatementSource="INSERT etl.LoadBatch&#xA;(&#xA;    SourceFolder,&#xA;    DatasetPeriodStart,&#xA;    DatasetPeriodEnd,&#xA;    LoadStatus&#xA;)&#xA;VALUES&#xA;(&#xA;    ?,&#xA;    CONVERT(date, '20260805'),&#xA;    CONVERT(date, '20260811'),&#xA;    'STARTED'&#xA;);&#xA;&#xA;SELECT CONVERT(bigint, SCOPE_IDENTITY()) AS LoadBatchKey;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="0"
            SQLTask:DtsVariableName="User::LoadBatchKey" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="$Project::pRawRoot"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="130"
            SQLTask:ParameterSize="500" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
  <DTS:PrecedenceConstraints>
    <DTS:PrecedenceConstraint
