      DTS:DTSID="{28A11B3F-1FA1-42C6-89BF-9E4B595C19C9}"
      DTS:From="Package\SQL - Reconcile Fact Load"
      DTS:LogicalAnd="True"
      DTS:ObjectName="Constraint 11"
      DTS:To="Package\PKG - Validate Final DWH" />
    <DTS:PrecedenceConstraint
      DTS:refId="Package.PrecedenceConstraints[Constraint 12]"
