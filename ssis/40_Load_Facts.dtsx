    P.EventID,
    S.SegmentKey
FROM DanangSmartParkingSTG.transform.ParkingEventClean P
INNER JOIN dwh.DimRoadSegment S
    ON S.SegmentID = P.SegmentID
   AND P.StartTimestamp &gt;= S.ValidFrom
   AND (
        P.StartTimestamp &lt; S.ValidTo
        OR S.ValidTo IS NULL
   )
WHERE P.IsValid = 1
  AND P.DuplicateRank = 1;) [refTable]
where [refTable].[EventID] = ?</property>
