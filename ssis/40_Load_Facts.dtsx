              componentClassID="Microsoft.Lookup"
              contactInfo="Lookup;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;6"
              description="Joins additional columns to the data flow by looking up values in a table. For example, join to the 'employee id' column the employees table to get 'hire date' and 'employee name'. We recommend this transformation when the lookup table can fit into memory."
              name="LKP - Parking Restriction Effective"
              usesDispositions="true"
              version="6">
              <properties>
                <property
                  dataType="System.String"
                  description="Specifies the SQL statement that generates the lookup table."
                  expressionType="Notify"
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT DISTINCT
    P.EventID,
    R.RestrictionKey
FROM DanangSmartParkingSTG.transform.ParkingEventClean P
INNER JOIN dwh.DimParkingRestriction R
    ON R.RestrictionID = P.ActiveRestrictionID
   AND P.StartTimestamp &gt;= R.ValidFrom
   AND (
        P.StartTimestamp &lt; R.ValidTo
        OR R.ValidTo IS NULL
   )
WHERE P.IsValid = 1
  AND P.DuplicateRank = 1
  AND P.ActiveRestrictionID IS NOT NULL;</property>
