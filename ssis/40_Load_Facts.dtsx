    R.RestrictionKey
FROM DanangSmartParkingSTG.transform.ParkingEventClean P
INNER JOIN dwh.DimParkingRestriction R
    ON R.RestrictionID = P.ActiveRestrictionID
   AND P.StartTimestamp &gt;= R.ValidFrom
   AND (
        P.StartTimestamp &lt; R.ValidTo
        OR R.ValidTo IS NULL
   )
WHERE P.IsValid = 1
  AND P.DuplicateRank = 1
  AND P.ActiveRestrictionID IS NOT NULL;) [refTable]
where [refTable].[EventID] = ?</property>
