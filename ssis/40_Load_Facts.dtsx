    RoadWidthM,
    ParkingOccupiedWidthM,
    EffectiveWidthM,
    WidthLossPct,
    CongestionIndex,
    RainMm,

    SpeedMissingFlag,
    VehicleMixValidFlag,
    ParkingCountValidFlag,

    RecordHashSHA256,

    CONVERT(datetime2(3), SYSDATETIME()) AS LoadedAt

FROM transform.TrafficObservationClean
WHERE LoadBatchKey = ?
  AND IsValid = 1
  AND DuplicateRank = 1;</property>
