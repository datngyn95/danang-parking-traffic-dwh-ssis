    <DTS:Executable
      DTS:refId="Package\SQL - Validate Fact Load"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{CEF1AB4F-DCB0-4ECF-A9EC-C4D943E58079}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL - Validate Fact Load"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{359A8995-C9EE-4D08-8748-273225D70AB2}"
          SQLTask:SqlStatementSource="/* ============================================================&#xA;   PACKAGE 40 - FACT LOAD ACCEPTANCE VALIDATION&#xA;   ============================================================ */&#xA;&#xA;DECLARE&#xA;    @ParkingCapacity bigint,&#xA;    @RoadSurvey      bigint,&#xA;    @Weather         bigint,&#xA;    @Traffic         bigint,&#xA;    @ParkingEvent    bigint;&#xA;&#xA;SELECT @ParkingCapacity = COUNT_BIG(*)&#xA;FROM dwh.FactParkingCapacitySnapshot;&#xA;&#xA;SELECT @RoadSurvey = COUNT_BIG(*)&#xA;FROM dwh.FactRoadSurveySnapshot;&#xA;&#xA;SELECT @Weather = COUNT_BIG(*)&#xA;FROM dwh.FactWeatherHourly;&#xA;&#xA;SELECT @Traffic = COUNT_BIG(*)&#xA;FROM dwh.FactTrafficObservation;&#xA;&#xA;SELECT @ParkingEvent = COUNT_BIG(*)&#xA;FROM dwh.FactParkingEvent;&#xA;&#xA;&#xA;/* ============================================================&#xA;   1. ROW COUNTS&#xA;   ============================================================ */&#xA;&#xA;IF @ParkingCapacity &lt;&gt; 20&#xA;    THROW 51000, 'PACKAGE 40 FAILED - FactParkingCapacitySnapshot count != 20', 1;&#xA;&#xA;IF @RoadSurvey &lt;&gt; 30&#xA;    THROW 51001, 'PACKAGE 40 FAILED - FactRoadSurveySnapshot count != 30', 1;&#xA;&#xA;IF @Weather &lt;&gt; 168&#xA;    THROW 51002, 'PACKAGE 40 FAILED - FactWeatherHourly count != 168', 1;&#xA;&#xA;IF @Traffic &lt;&gt; 16800&#xA;    THROW 51003, 'PACKAGE 40 FAILED - FactTrafficObservation count != 16800', 1;&#xA;&#xA;IF @ParkingEvent &lt;&gt; 4283&#xA;    THROW 51004, 'PACKAGE 40 FAILED - FactParkingEvent count != 4283', 1;&#xA;&#xA;&#xA;/* ============================================================&#xA;   2. PARKING CAPACITY UNIQUE GRAIN&#xA;      SnapshotDateKey + ParkingFacilityKey&#xA;   ============================================================ */&#xA;&#xA;IF EXISTS&#xA;(&#xA;    SELECT&#xA;        SnapshotDateKey,&#xA;        ParkingFacilityKey&#xA;    FROM dwh.FactParkingCapacitySnapshot&#xA;    GROUP BY&#xA;        SnapshotDateKey,&#xA;        ParkingFacilityKey&#xA;    HAVING COUNT_BIG(*) &gt; 1&#xA;)&#xA;    THROW 51010, 'PACKAGE 40 FAILED - duplicate ParkingCapacity grain', 1;&#xA;&#xA;&#xA;/* ============================================================&#xA;   3. ROAD SURVEY UNIQUE GRAIN&#xA;      SnapshotDateKey + SegmentKey&#xA;   ============================================================ */&#xA;&#xA;IF EXISTS&#xA;(&#xA;    SELECT&#xA;        SnapshotDateKey,&#xA;        SegmentKey&#xA;    FROM dwh.FactRoadSurveySnapshot&#xA;    GROUP BY&#xA;        SnapshotDateKey,&#xA;        SegmentKey&#xA;    HAVING COUNT_BIG(*) &gt; 1&#xA;)&#xA;    THROW 51011, 'PACKAGE 40 FAILED - duplicate RoadSurvey grain', 1;&#xA;&#xA;&#xA;/* ============================================================&#xA;   4. WEATHER UNIQUE GRAIN&#xA;      WeatherTimestamp&#xA;   ============================================================ */&#xA;&#xA;IF EXISTS&#xA;(&#xA;    SELECT WeatherTimestamp&#xA;    FROM dwh.FactWeatherHourly&#xA;    GROUP BY WeatherTimestamp&#xA;    HAVING COUNT_BIG(*) &gt; 1&#xA;)&#xA;    THROW 51012, 'PACKAGE 40 FAILED - duplicate WeatherTimestamp', 1;&#xA;&#xA;&#xA;/* ============================================================&#xA;   5. TRAFFIC UNIQUE GRAIN&#xA;      EventID&#xA;   ============================================================ */&#xA;&#xA;IF EXISTS&#xA;(&#xA;    SELECT EventID&#xA;    FROM dwh.FactTrafficObservation&#xA;    GROUP BY EventID&#xA;    HAVING COUNT_BIG(*) &gt; 1&#xA;)&#xA;    THROW 51013, 'PACKAGE 40 FAILED - duplicate Traffic EventID', 1;&#xA;&#xA;&#xA;/* ============================================================&#xA;   6. PARKING EVENT UNIQUE GRAIN&#xA;      EventID&#xA;   ============================================================ */&#xA;&#xA;IF EXISTS&#xA;(&#xA;    SELECT EventID&#xA;    FROM dwh.FactParkingEvent&#xA;    GROUP BY EventID&#xA;    HAVING COUNT_BIG(*) &gt; 1&#xA;)&#xA;    THROW 51014, 'PACKAGE 40 FAILED - duplicate Parking EventID', 1;&#xA;&#xA;&#xA;/* ============================================================&#xA;   7. PARKING CAPACITY FK CHECK&#xA;   ============================================================ */&#xA;&#xA;IF EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM dwh.FactParkingCapacitySnapshot F&#xA;    LEFT JOIN dwh.DimDate D&#xA;        ON D.DateKey = F.SnapshotDateKey&#xA;    LEFT JOIN dwh.DimParkingFacility P&#xA;        ON P.ParkingFacilityKey = F.ParkingFacilityKey&#xA;    WHERE D.DateKey IS NULL&#xA;       OR P.ParkingFacilityKey IS NULL&#xA;)&#xA;    THROW 51020, 'PACKAGE 40 FAILED - ParkingCapacity orphan dimension key', 1;&#xA;&#xA;&#xA;/* ============================================================&#xA;   8. ROAD SURVEY FK CHECK&#xA;   ============================================================ */&#xA;&#xA;IF EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM dwh.FactRoadSurveySnapshot F&#xA;    LEFT JOIN dwh.DimDate D&#xA;        ON D.DateKey = F.SnapshotDateKey&#xA;    LEFT JOIN dwh.DimRoadSegment S&#xA;        ON S.SegmentKey = F.SegmentKey&#xA;    WHERE D.DateKey IS NULL&#xA;       OR S.SegmentKey IS NULL&#xA;)&#xA;    THROW 51021, 'PACKAGE 40 FAILED - RoadSurvey orphan dimension key', 1;&#xA;&#xA;&#xA;/* ============================================================&#xA;   9. WEATHER FK CHECK&#xA;   ============================================================ */&#xA;&#xA;IF EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM dwh.FactWeatherHourly F&#xA;    LEFT JOIN dwh.DimDate D&#xA;        ON D.DateKey = F.DateKey&#xA;    LEFT JOIN dwh.DimTime T&#xA;        ON T.TimeKey = F.TimeKey&#xA;    LEFT JOIN dwh.DimWeatherSource W&#xA;        ON W.WeatherSourceKey = F.WeatherSourceKey&#xA;    WHERE D.DateKey IS NULL&#xA;       OR T.TimeKey IS NULL&#xA;       OR W.WeatherSourceKey IS NULL&#xA;)&#xA;    THROW 51022, 'PACKAGE 40 FAILED - Weather orphan dimension key', 1;&#xA;&#xA;&#xA;/* ============================================================&#xA;   10. TRAFFIC FK CHECK&#xA;   ============================================================ */&#xA;&#xA;IF EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM dwh.FactTrafficObservation F&#xA;    LEFT JOIN dwh.DimDate D&#xA;        ON D.DateKey = F.DateKey&#xA;    LEFT JOIN dwh.DimTime T1&#xA;        ON T1.TimeKey = F.TimeKey&#xA;    LEFT JOIN dwh.DimTime T2&#xA;        ON T2.TimeKey = F.HourTimeKey&#xA;    LEFT JOIN dwh.DimRoadSegment S&#xA;        ON S.SegmentKey = F.SegmentKey&#xA;    LEFT JOIN dwh.DimCamera C&#xA;        ON C.CameraKey = F.CameraKey&#xA;    WHERE D.DateKey IS NULL&#xA;       OR T1.TimeKey IS NULL&#xA;       OR T2.TimeKey IS NULL&#xA;       OR S.SegmentKey IS NULL&#xA;       OR C.CameraKey IS NULL&#xA;)&#xA;    THROW 51023, 'PACKAGE 40 FAILED - Traffic orphan dimension key', 1;&#xA;&#xA;&#xA;/* ============================================================&#xA;   11. PARKING EVENT MANDATORY FK CHECK&#xA;   ============================================================ */&#xA;&#xA;IF EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM dwh.FactParkingEvent F&#xA;    LEFT JOIN dwh.DimDate SD&#xA;        ON SD.DateKey = F.StartDateKey&#xA;    LEFT JOIN dwh.DimTime ST&#xA;        ON ST.TimeKey = F.StartTimeKey&#xA;    LEFT JOIN dwh.DimRoadSegment S&#xA;        ON S.SegmentKey = F.SegmentKey&#xA;    LEFT JOIN dwh.DimVehicleType V&#xA;        ON V.VehicleTypeKey = F.VehicleTypeKey&#xA;    LEFT JOIN dwh.DimRoadSide RS&#xA;        ON RS.RoadSideKey = F.RoadSideKey&#xA;    WHERE SD.DateKey IS NULL&#xA;       OR ST.TimeKey IS NULL&#xA;       OR S.SegmentKey IS NULL&#xA;       OR V.VehicleTypeKey IS NULL&#xA;       OR RS.RoadSideKey IS NULL&#xA;)&#xA;    THROW 51024, 'PACKAGE 40 FAILED - ParkingEvent mandatory orphan dimension key', 1;&#xA;&#xA;&#xA;/* ============================================================&#xA;   12. PARKING OPTIONAL FK CHECK&#xA;   ============================================================ */&#xA;&#xA;IF EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM dwh.FactParkingEvent F&#xA;    LEFT JOIN dwh.DimDate ED&#xA;        ON ED.DateKey = F.EndDateKey&#xA;    WHERE F.EndDateKey IS NOT NULL&#xA;      AND ED.DateKey IS NULL&#xA;)&#xA;    THROW 51025, 'PACKAGE 40 FAILED - ParkingEvent invalid EndDateKey', 1;&#xA;&#xA;&#xA;IF EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM dwh.FactParkingEvent F&#xA;    LEFT JOIN dwh.DimTime ET&#xA;        ON ET.TimeKey = F.EndTimeKey&#xA;    WHERE F.EndTimeKey IS NOT NULL&#xA;      AND ET.TimeKey IS NULL&#xA;)&#xA;    THROW 51026, 'PACKAGE 40 FAILED - ParkingEvent invalid EndTimeKey', 1;&#xA;&#xA;&#xA;IF EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM dwh.FactParkingEvent F&#xA;    LEFT JOIN dwh.DimParkingRestriction R&#xA;        ON R.RestrictionKey = F.RestrictionKey&#xA;    WHERE F.RestrictionKey IS NOT NULL&#xA;      AND R.RestrictionKey IS NULL&#xA;)&#xA;    THROW 51027, 'PACKAGE 40 FAILED - ParkingEvent invalid RestrictionKey', 1;&#xA;&#xA;&#xA;/* ============================================================&#xA;   PASS&#xA;   ============================================================ */&#xA;&#xA;PRINT 'PACKAGE 40 FACT LOAD VALIDATION = PASS';&#xA;PRINT 'FactParkingCapacitySnapshot = 20';&#xA;PRINT 'FactRoadSurveySnapshot      = 30';&#xA;PRINT 'FactWeatherHourly           = 168';&#xA;PRINT 'FactTrafficObservation      = 16800';&#xA;PRINT 'FactParkingEvent            = 4283';&#xA;PRINT 'TOTAL FACT ROWS             = 21301';" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="$Package::pLoadBatchKey"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
