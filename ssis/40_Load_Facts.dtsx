                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT
    LoadFileKey,
    SourceRowNumber,

    EventID,
    EventTimestamp,
    EventDate,

    CONVERT(
        time(0),
        DATEADD(
            MINUTE,
            DATEDIFF(MINUTE, 0, EventTimestamp),
            0
        )
    ) AS EventMinuteTime,

    CONVERT(
        time(0),
        DATEADD(
            HOUR,
            DATEDIFF(HOUR, 0, EventTimestamp),
            0
        )
    ) AS HourTimeValue,

    CameraID,
    SegmentID,

    VehicleCount,
    MotorbikeCount,
    CarCount,
    BusCount,
    TruckCount,
